        function shuffleArray(array) {
            const newArray = [...array];
            for (let i = newArray.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
            }
            return newArray;
        }
        
        function updateStudentData() {
            const nameInput = document.getElementById('studentNameInput');
            const classInput = document.getElementById('studentClassInput');
            
            if (nameInput && classInput) {
                studentData.name = nameInput.value.trim();
                studentData.className = classInput.value.trim();
                localStorage.setItem('studentData', JSON.stringify(studentData));
            }
        }
        
        function loadStudentData() {
            const saved = localStorage.getItem('studentData');
            if (saved) {
                try {
                    const data = JSON.parse(saved);
                    studentData = data;
                    
                    const nameInput = document.getElementById('studentNameInput');
                    const classInput = document.getElementById('studentClassInput');
                    if (nameInput) nameInput.value = studentData.name || '';
                    if (classInput) classInput.value = studentData.className || '';
                } catch (e) {
                    console.error('Ошибка загрузки данных ученика:', e);
                }
            }
        }
        
        function selectSingleChoice(element) {
            const itemId = element.dataset.id;
            const answerIndex = parseInt(element.dataset.index);
            
            if (studentAnswers[itemId]?.checked) return;
            
            const allOptions = document.querySelectorAll(`[data-id="${itemId}"]`);
            allOptions.forEach(opt => opt.classList.remove('selected'));
            
            element.classList.add('selected');
            
            studentAnswers[itemId] = {
                type: 'single-choice',
                answer: answerIndex,
                checked: false
            };
            
            localStorage.setItem('studentWork', JSON.stringify(studentAnswers));
        }
        
        function selectMultipleChoice(element) {
            const itemId = element.dataset.id;
            const answerIndex = parseInt(element.dataset.index);
            
            if (studentAnswers[itemId]?.checked) return;
            
            element.classList.toggle('selected');
            
            if (!studentAnswers[itemId]) {
                studentAnswers[itemId] = {
                    type: 'multiple-choice',
                    answer: [],
                    checked: false
                };
            }
            
            const answers = studentAnswers[itemId].answer;
            const indexInAnswers = answers.indexOf(answerIndex);
            
            if (indexInAnswers === -1) {
                answers.push(answerIndex);
            } else {
                answers.splice(indexInAnswers, 1);
            }
            
            if (answers.length === 0) {
                delete studentAnswers[itemId];
            }
            
            localStorage.setItem('studentWork', JSON.stringify(studentAnswers));
        }
        
        function selectGap(element) {
            if (studentAnswers[element.dataset.id]?.checked) return;
            
            document.querySelectorAll('.gap-placeholder').forEach(gap => {
                gap.classList.remove('selected');
            });
            
            element.classList.add('selected');
            selectedGap = element;
        }
        
        function selectWordForGap(element) {
            if (selectedGap && studentAnswers[selectedGap.dataset.id]?.checked) return;
            
            const itemId = selectedGap.dataset.id;
            const gapNum = parseInt(selectedGap.dataset.gapNum);
            const word = element.dataset.word;
            const correctFor = parseInt(element.dataset.correctFor);
            
            selectedGap.textContent = word;
            selectedGap.classList.remove('selected');
            selectedGap.classList.add('filled');
            if (correctFor === gapNum) {
                selectedGap.classList.add('filled');
            } else {
                selectedGap.classList.add('incorrect-filled');
            }
            
            element.classList.add('used');
            element.classList.remove('selected');
            
            if (!studentAnswers[itemId]) {
                studentAnswers[itemId] = {
                    type: 'gap-fill',
                    answers: {}
                };
            }
            
            studentAnswers[itemId].answers[gapNum] = {
                word: word,
                isCorrect: correctFor === gapNum
            };
            
            localStorage.setItem('studentWork', JSON.stringify(studentAnswers));
            selectedGap = null;
        }
        
