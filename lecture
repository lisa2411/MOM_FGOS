            <p><strong>Дата выполнения:</strong> ${date}</p>
        </div>
        
        <div class="stats">
            <div class="stat-box" style="border-left: 4px solid #27ae60;">
                <div class="stat-value" style="color: #27ae60;">${results.correct}</div>
                <div>Правильных ответов</div>
            </div>
            <div class="stat-box" style="border-left: 4px solid #e74c3c;">
                <div class="stat-value" style="color: #e74c3c;">${results.total - results.correct}</div>
                <div>Неправильных ответов</div>
            </div>
            <div class="stat-box" style="border-left: 4px solid #3498db;">
                <div class="stat-value" style="color: #3498db;">${results.total}</div>
                <div>Всего заданий</div>
            </div>
            <div class="stat-box" style="border-left: 4px solid #f39c12;">
                <div class="stat-value" style="color: #f39c12;">${percentage}%</div>
                <div>Процент правильных</div>
            </div>
        </div>
        
        ${explanationsHTML ? `
        <div class="explanations-section">
            <h2>📚 Пояснения к заданиям</h2>
            <p style="margin: 15px 0; color: #666; font-size: 16px;">
                Здесь представлены пояснения учителя к заданиям, которые помогут вам лучше понять материал.
            </p>
            ${explanationsHTML}
        </div>
        ` : ''}
        
        <div class="timestamp">
            <p>Рабочий лист выполнен и сохранён: ${date}</p>
            <p>Для печати нажмите Ctrl+P</p>
        </div>
    </div>
</body>
</html>`;
            
            const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const fileName = `Результаты_с_пояснениями_${studentData.name.replace(/[^а-яА-ЯёЁa-zA-Z0-9\s]/g, '').replace(/\s+/g, '_')}_${worksheetData.title}_${new Date().toISOString().slice(0, 10)}.html`
                .replace(/[^а-яА-ЯёЁa-zA-Z0-9\s]/g, '')
                .replace(/\s+/g, '_');
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        
        function resetAnswers() {
            if (confirm('Сбросить все ответы?')) {
                studentAnswers = {};
                document.querySelectorAll('.option-item, .matching-item, .ordering-item, .gap-placeholder, .gap-word, .essay-textarea').forEach(el => {
                    el.classList.remove('selected', 'correct', 'incorrect', 'matched', 'correct-order', 'incorrect-order', 'filled', 'incorrect-filled', 'used');
                });
                document.querySelectorAll('.gap-placeholder').forEach(gap => {
                    gap.textContent = '?';
                });
                document.querySelectorAll('.essay-textarea').forEach(textarea => {
                    textarea.value = '';
                    const itemId = textarea.dataset.id;
                    const wordCountElement = document.getElementById(`essayWordCount_${itemId}`);
                    if (wordCountElement) {
                        wordCountElement.innerHTML = `Слов в вашем ответе: <strong>0</strong>`;
                    }
                });
                localStorage.removeItem('studentWork');
                document.getElementById('resultsModal').classList.remove('active');
                document.getElementById('explanationsModal').classList.remove('active');
            }
        }
        
        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }
        
        function showNotification(message, type = 'success') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = 'notification' + (type === 'error' ? ' error' : '');
            notification.classList.add('show');
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }
        
        window.onload = function() {
            loadStudentData();
            initDragAndDrop();
            
            const saved = localStorage.getItem('studentWork');
            if (saved) {
                try {
                    studentAnswers = JSON.parse(saved);
                    
                    Object.keys(studentAnswers).forEach(itemId => {
                        const answer = studentAnswers[itemId];
                        if (answer.type === 'single-choice') {
                            const el = document.querySelector(`[data-id="${itemId}"][data-index="${answer.answer}"]`);
                            if (el) el.classList.add('selected');
                        } else if (answer.type === 'multiple-choice') {
                            answer.answer.forEach(index => {
                                const el = document.querySelector(`[data-id="${itemId}"][data-index="${index}"]`);
                                if (el) el.classList.add('selected');
                            });
                        } else if (answer.type === 'matching') {
                            answer.matches.forEach(match => {
                                const leftEl = document.querySelector(`[data-id="${itemId}"][data-left-index="${match.left}"]`);
                                const rightEl = document.querySelector(`[data-id="${itemId}"][data-right-index="${match.right}"]`);
                                if (leftEl) leftEl.classList.add('matched');
                                if (rightEl) rightEl.classList.add('matched');
                            });
                        } else if (answer.type === 'ordering') {
                            if (answer.order) {
                                updateOrderingDisplayForExport(itemId, answer.order);
                            }
                        } else if (answer.type === 'essay') {
                            const textarea = document.getElementById(`essayAnswer_${itemId}`);
                            if (textarea) {
                                textarea.value = answer.text || '';
                                
                                const wordCount = answer.wordCount || 0;
                                const wordCountElement = document.getElementById(`essayWordCount_${itemId}`);
                                const item = worksheetData.items.find(item => item.id === itemId);
                                if (wordCountElement && item) {
                                    wordCountElement.innerHTML = `
                                        Слов в вашем ответе: <strong>${wordCount}</strong>
                                        ${wordCount < item.minWords ? '<span style="color: #e74c3c;"> (слишком мало слов)</span>' : 
                                         wordCount > item.maxWords ? '<span style="color: #e74c3c;"> (слишком много слов)</span>' :
                                         wordCount >= item.minWords && wordCount <= item.maxWords ? '<span style="color: #27ae60;"> (подходит)</span>' : ''}
                                    `;
                                }
                            }
                        } else if (answer.type === 'gap-fill') {
                            Object.keys(answer.answers).forEach(gapNum => {
                                const gapAnswer = answer.answers[gapNum];
                                const gapElement = document.querySelector(
                                    `[data-id="${itemId}"][data-gap-num="${gapNum}"]`
                                );
                                if (gapElement) {
                                    gapElement.textContent = gapAnswer.word;
                                    gapElement.classList.add('filled');
                                    if (gapAnswer.isCorrect) {
                                        gapElement.classList.add('filled');
                                    } else {
                                        gapElement.classList.add('incorrect-filled');
                                    }
                                    
                                    const wordElements = document.querySelectorAll(`#words_${itemId} .gap-word`);
                                    wordElements.forEach(wordEl => {
                                        if (wordEl.dataset.word === gapAnswer.word) {
                                            wordEl.classList.add('used');
                                        }
                                    });
                                }
                            });
                        }
                    });
                } catch (e) {
                    console.error('Ошибка загрузки ответов:', e);
                }
            }
            
            const nameInput = document.getElementById('studentNameInput');
            const classInput = document.getElementById('studentClassInput');
            
            if (nameInput) {
                nameInput.addEventListener('input', updateStudentData);
            }
            if (classInput) {
                classInput.addEventListener('input', updateStudentData);
            }
        };
    </script>
</body>
</html>
