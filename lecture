        // Drag & Drop
        function initDragAndDrop() {
            document.addEventListener('dragstart', handleDragStart);
            document.addEventListener('dragover', handleDragOver);
            document.addEventListener('drop', handleDrop);
            document.addEventListener('dragend', handleDragEnd);
        }
        
        function handleDragStart(e) {
            if (e.target.classList.contains('matching-item') || 
                e.target.classList.contains('ordering-item')) {
                
                draggedElement = e.target;
                draggedType = e.target.classList.contains('matching-item') ? 'matching' : 'ordering';
                
                e.target.classList.add('dragging');
                e.dataTransfer.setData('text/plain', e.target.textContent);
                e.dataTransfer.effectAllowed = 'move';
            }
        }
        
        function handleDragOver(e) {
            e.preventDefault();
            
            if (draggedType === 'matching' && e.target.classList.contains('matching-item')) {
                e.target.classList.add('drag-over');
            } else if (draggedType === 'ordering' && e.target.classList.contains('ordering-item')) {
                e.target.classList.add('drag-over');
            }
        }
        
        function handleDrop(e) {
            e.preventDefault();
            
            if (!draggedElement) return;
            
            const itemId = draggedElement.dataset.id;
            
            if (draggedType === 'matching' && e.target.classList.contains('matching-item')) {
                handleMatchingDrop(draggedElement, e.target, itemId);
            } else if (draggedType === 'ordering' && e.target.classList.contains('ordering-item')) {
                handleOrderingDrop(draggedElement, e.target, itemId);
            }
            
            document.querySelectorAll('.drag-over').forEach(el => {
                el.classList.remove('drag-over');
            });
        }
        
        function handleDragEnd() {
            if (draggedElement) {
                draggedElement.classList.remove('dragging');
                draggedElement = null;
                draggedType = null;
            }
            
            document.querySelectorAll('.drag-over').forEach(el => {
                el.classList.remove('drag-over');
            });
        }
        
        function handleMatchingDrop(source, target, itemId) {
            if (source.parentElement === target.parentElement) return;
            
            const leftIndex = parseInt(source.dataset.leftIndex);
            const rightIndex = parseInt(target.dataset.rightIndex);
            
            if (!studentAnswers[itemId]) {
                studentAnswers[itemId] = {
                    type: 'matching',
                    matches: []
                };
            }
            
            studentAnswers[itemId].matches = studentAnswers[itemId].matches.filter(
                match => match.left !== leftIndex
            );
            
            studentAnswers[itemId].matches.push({
                left: leftIndex,
                right: rightIndex
            });
            
            localStorage.setItem('studentWork', JSON.stringify(studentAnswers));
            
            source.classList.add('matched');
            target.classList.add('matched');
        }
        
        function handleOrderingDrop(source, target, itemId) {
            const sourceIndex = parseInt(source.dataset.index);
            const targetIndex = parseInt(target.dataset.index);
            
            if (sourceIndex === targetIndex) return;
            
            const item = worksheetData.items.find(item => item.id === itemId);
            if (!item) return;
            
            let currentOrder = [];
            if (studentAnswers[itemId] && studentAnswers[itemId].order) {
                currentOrder = studentAnswers[itemId].order;
            } else {
                const container = document.querySelector(`[data-id="${itemId}"] .ordering-container`);
                if (container) {
                    const items = Array.from(container.querySelectorAll('.ordering-item'));
                    currentOrder = items.map(item => parseInt(item.dataset.originalIndex));
                }
            }
            
            const movedItem = currentOrder.splice(sourceIndex, 1)[0];
            currentOrder.splice(targetIndex, 0, movedItem);
            
            studentAnswers[itemId] = {
                type: 'ordering',
                order: currentOrder,
                checked: false
            };
            
            localStorage.setItem('studentWork', JSON.stringify(studentAnswers));
            
            updateOrderingDisplayForExport(itemId, currentOrder);
        }
        
        function updateOrderingDisplayForExport(itemId, order) {
            const container = document.querySelector(`[data-id="${itemId}"] .ordering-container`);
            if (!container) return;
            
            const item = worksheetData.items.find(item => item.id === itemId);
            if (!item) return;
            
            const orderedItems = order.map(originalIndex => {
                return {
                    text: item.items[originalIndex],
                    originalIndex: originalIndex
                };
            });
            
            container.innerHTML = '';
            orderedItems.forEach((itemObj, index) => {
                const div = document.createElement('div');
                div.className = 'ordering-item';
                div.dataset.id = itemId;
                div.dataset.originalIndex = itemObj.originalIndex;
                div.dataset.index = index;
                div.draggable = true;
                
                div.innerHTML = `
                    <div class="ordering-number">${index + 1}</div>
                    <div>${itemObj.text}</div>
                `;
                
                container.appendChild(div);
            });
            
            initDragAndDrop();
        }
        
        function checkAnswers() {
            let correct = 0;
            let total = 0;
            let essayCount = 0;
            
            worksheetData.items.forEach(item => {
                if (item.type === 'single-choice' || item.type === 'multiple-choice' ||
                    item.type === 'matching' || item.type === 'ordering' || item.type === 'gap-fill') {
                    
                    total++;
                    const studentAnswer = studentAnswers[item.id];
                    
                    if (studentAnswer) {
                        studentAnswer.checked = true;
                        
                        switch(item.type) {
                            case 'single-choice':
                                const correctIndexSingle = item.options.findIndex(opt => opt.correct);
                                studentAnswer.correct = studentAnswer.answer === correctIndexSingle;
                                if (studentAnswer.correct) correct++;
                                break;
                                
                            case 'multiple-choice':
                                const correctIndicesMulti = item.options
                                    .map((opt, idx) => opt.correct ? idx : -1)
                                    .filter(idx => idx !== -1);
                                
                                const studentIndicesMulti = [...studentAnswer.answer].sort();
                                const sortedCorrectMulti = [...correctIndicesMulti].sort();
                                
                                studentAnswer.correct = JSON.stringify(studentIndicesMulti) === JSON.stringify(sortedCorrectMulti);
                                if (studentAnswer.correct) correct++;
                                break;
                                
                            case 'matching':
                                let matchingCorrect = true;
                                if (studentAnswer.matches.length !== item.pairs.length) {
                                    matchingCorrect = false;
                                } else {
                                    studentAnswer.matches.forEach(match => {
                                        if (item.pairs[match.left].right !== item.pairs[match.right].right) {
                                            matchingCorrect = false;
                                        }
                                    });
                                }
                                
                                studentAnswer.correct = matchingCorrect;
                                if (matchingCorrect) correct++;
                                break;
                                
                            case 'ordering':
                                let orderingCorrect = true;
                                
                                if (!studentAnswer.order || studentAnswer.order.length !== item.items.length) {
                                    orderingCorrect = false;
                                } else {
                                    for (let i = 0; i <studentAnswer.order.length; i++) {
                                        if (studentAnswer.order[i] !== i) {
                                            orderingCorrect = false;
                                            break;
                                        }
                                    }
                                }
                                
                                studentAnswer.correct = orderingCorrect;
                                if (orderingCorrect) correct++;
                                break;
                                
                            case 'gap-fill':
                                let gapFillCorrect = true;
                                const studentGapAnswers = studentAnswer.answers || {};
                                
                                Object.keys(item.gaps).forEach(gapNum => {
                                    const studentWord = studentGapAnswers[gapNum]?.word;
                                    const correctWord = item.gaps[gapNum].correct;
                                    
                                    if (!studentWord || studentWord !== correctWord) {
                                        gapFillCorrect = false;
                                    }
                                });
                                
                                studentAnswer.correct = gapFillCorrect;
                                if (gapFillCorrect) correct++;
                                break;
                        }
                    }
                } else if (item.type === 'essay') {
                    essayCount++;
                    const studentAnswer = studentAnswers[item.id];
                    if (studentAnswer) {
                        studentAnswer.checked = false;
                        studentAnswer.correct = false;
                    }
                }
            });
            
            updateVisualFeedback();
            
            let message = `Проверка завершена! Правильно: ${correct} из ${total}`;
            if (essayCount > 0) {
                message += ` (плюс ${essayCount} эссе для проверки учителем)`;
            }
            
            showNotification(message);
            
            return { correct, total, essayCount };
        }
        
        function updateVisualFeedback() {
            worksheetData.items.forEach(item => {
                if (item.type === 'single-choice' || item.type === 'multiple-choice') {
                    const studentAnswer = studentAnswers[item.id];
                    if (studentAnswer?.checked) {
                        const options = document.querySelectorAll(`[data-id="${item.id}"]`);
                        options.forEach(opt => {
                            const index = parseInt(opt.dataset.index);
                            let isCorrectOption = false;
                            let isSelected = false;
                            
                            if (item.type === 'single-choice') {
                                isCorrectOption = item.options[index]?.correct || false;
                                isSelected = studentAnswer.answer === index;
                            } else if (item.type === 'multiple-choice') {
                                isCorrectOption = item.options[index]?.correct || false;
                                isSelected = studentAnswer.answer.includes(index);
                            }
                            
                            opt.classList.remove('correct', 'incorrect');
                            if (isCorrectOption) {
                                opt.classList.add('correct');
                            }
                            if (isSelected && !isCorrectOption) {
                                opt.classList.add('incorrect');
                            }
                        });
                    }
                } else if (item.type === 'matching') {
                    const studentAnswer = studentAnswers[item.id];
                    if (studentAnswer?.checked) {
                        const leftItems = document.querySelectorAll(`[data-id="${item.id}"][data-left-index]`);
                        const rightItems = document.querySelectorAll(`[data-id="${item.id}"][data-right-index]`);
                        
                        leftItems.forEach(item => item.classList.remove('matched', 'incorrect-match'));
                        rightItems.forEach(item => item.classList.remove('matched', 'incorrect-match'));
                        
                        studentAnswer.matches.forEach(match => {
                            const isCorrect = item.pairs[match.left].right === item.pairs[match.right].right;
                            
                            const leftItem = document.querySelector(`[data-id="${item.id}"][data-left-index="${match.left}"]`);
                            const rightItem = document.querySelector(`[data-id="${item.id}"][data-right-index="${match.right}"]`);
                            
                            if (leftItem) {
                                leftItem.classList.add(isCorrect ? 'matched' : 'incorrect-match');
                            }
                            if (rightItem) {
                                rightItem.classList.add(isCorrect ? 'matched' : 'incorrect-match');
                            }
                        });
                    }
                } else if (item.type === 'ordering') {
                    const studentAnswer = studentAnswers[item.id];
                    if (studentAnswer?.checked) {
                        const orderingItems = document.querySelectorAll(`[data-id="${item.id}"] .ordering-item`);
                        orderingItems.forEach(el => {
                            const currentIndex = parseInt(el.dataset.index);
                            const originalIndex = parseInt(el.dataset.originalIndex);
                            const isCorrect = currentIndex === originalIndex;
                            
                            el.classList.remove('correct-order', 'incorrect-order');
                            el.classList.add(isCorrect ? 'correct-order' : 'incorrect-order');
                        });
                    }
                } else if (item.type === 'gap-fill') {
                    const studentAnswer = studentAnswers[item.id];
                    if (studentAnswer?.checked) {
                        const studentGapAnswers = studentAnswer.answers || {};
                        
                        Object.keys(studentGapAnswers).forEach(gapNum => {
                            const gapAnswer = studentGapAnswers[gapNum];
                            const gapElement = document.querySelector(
                                `[data-id="${item.id}"][data-gap-num="${gapNum}"]`
                            );
                            if (gapElement) {
                                gapElement.classList.remove('filled', 'incorrect-filled');
                                if (gapAnswer.isCorrect) {
                                    gapElement.classList.add('filled');
                                } else {
                                    gapElement.classList.add('incorrect-filled');
                                }
                            }
                        });
                    }
                }
            });
        }
        
